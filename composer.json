{
	"name": "iorgian/core",
	"type": "phpbb-extension",
	"description": "Shared base library for the iorgian extensions: compatibility layer, permission helpers, forum/group helpers, badges, ACP color field, zero-knowledge key storage and browser crypto helpers (libsodium) for phpBB 3.3.x (4.0 ready).",
	"homepage": "https://github.com/iorGian/phpbb-ext-iorgian-core",
	"version": "0.3.0-a1",
	"time": "2026-10-24",
	"keywords": [
		"phpbb",
		"extension",
		"library",
		"iorgian",
		"core"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Georgian Iordache",
			"homepage": "https://github.com/iorGian",
			"email": "iorgian19@gmail.com",
			"role": "Extension Developer"
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"extra": {
		"display-name": "Iorgian Core",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0"
		},
		"version-check": {
			"host": "raw.githubusercontent.com",
			"directory": "/iorGian/phpbb-ext-iorgian-core/main",
			"filename": "version.json",
			"ssl": true
		}
	}
}
